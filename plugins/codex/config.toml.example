# Register the ArcLang MCP server in Codex: copy this table into ~/.codex/config.toml
# (or .codex/config.toml in a trusted project), or run:
#
#   codex mcp add arclang -- arclang-mcp
#
# `arclang-mcp` is the server of this repository (pip install -e mcp-server).
[mcp_servers.arclang]
command = "arclang-mcp"
# A chip layout or a topology run is minutes: the default tool timeout is 60 s.
tool_timeout_sec = 900
startup_timeout_sec = 30
# What the server reads: where the compiler and the Enterprise server are.
env_vars = ["ARCLANG_BINARY", "ARCLANG_SERVER", "ARCLANG_WORKSPACE"]
