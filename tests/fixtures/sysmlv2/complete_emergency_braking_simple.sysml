        transition t1 first Standby then Warning;  // trigger: AssessThreat
        transition t2 first Warning then EmergencyBraking;  // trigger: ComputeBrakingForce
        transition t3 first EmergencyBraking then Standby;  // trigger: MonitorVehicleState
