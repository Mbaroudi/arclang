    }
    action a_SF_DET : Detect_lane_markings;
    action def <'SF-EST'> Estimate_departure :> Periodic_task {
        doc /* Estimate departure */
        in item lane : LaneModel;
        out item departure : DepartureEstimate;
        attribute latency : DurationValue = 15 [ms];
        attribute wcet : DurationValue = 18 [ms];
    }
    action a_SF_EST : Estimate_departure;
    action def <'SF-CMD'> Command_steering :> Periodic_task {
        doc /* Command steering */
        in item departure : DepartureEstimate;
        attribute latency : DurationValue = 10 [ms];
        attribute wcet : DurationValue = 12 [ms];
    }
    action a_SF_CMD : Command_steering;
    action def <'Capture frame'> Capture_frame {
        doc /* Capture frame (logical function of Camera) */
