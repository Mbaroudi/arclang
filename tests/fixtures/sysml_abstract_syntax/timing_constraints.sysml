        doc /* Chassis ECU (physical node) */
        attribute ram : StorageCapacityValue = 64 [MB];
    }
    part p_PN_CHS : Chassis_ECU;
    allocate p_LC_CAM to p_PN_CAM;
    allocate p_LC_CTL to p_PN_CHS;

    // ---- Exchanges ----
    flow from a_SF_DET.lane to a_SF_EST.lane;  // lane model
    flow from a_SF_EST.departure to a_SF_CMD.departure;  // departure estimate
    connect p_LC_CAM.lane to p_LC_CTL.lane;  // LaneFlow [Data]
