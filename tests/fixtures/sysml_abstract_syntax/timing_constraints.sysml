    }
    action def <'Plan correction'> Plan_correction {
        doc /* Plan correction (logical function of LKA Controller) */
    }

    // ---- Functional chains ----
    action def <'FC-LKA'> chain_Lane_departure_reaction {
        doc /* Lane departure reaction */
        action step1 : Detect_lane_markings;
        then action step2 : Estimate_departure;
        then action step3 : Command_steering;
        attribute latency_budget : DurationValue = 80 [ms];
    }
    action a_FC_LKA : chain_Lane_departure_reaction;

    // ---- Port definitions ----
    port def In_LaneModel_Port { in item data : LaneModel; }
    port def Out_LaneModel_Port { out item data : LaneModel; }

    // ---- Actors & components ----
