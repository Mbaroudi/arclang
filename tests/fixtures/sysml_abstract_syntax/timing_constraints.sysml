    // ---- Requirements ----
    requirement <'REQ-LKA-001'> req_REQ_LKA_001 {
        doc /* Steering correction shall be commanded within 80 ms of lane departure detection */
        attribute priority : String = "Critical";
        attribute safety_level : String = "ASIL-B";
    }

