        }
    }

    // ---- Constraints ----
    assert constraint <'CST-LKA-001'> Reaction_time_margin {
        doc /* Reaction time margin — Sum of function latencies stays within 80 % of the chain budget */
        (a_SF_DET.latency + a_SF_EST.latency + a_SF_CMD.latency) <= (a_FC_LKA.latency_budget * 0.8)
