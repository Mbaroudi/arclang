// ============================================================================
// BATTERY CHARGER CONTROLLER - behavior generated as portable C (docs/embedded-c.md)
// ============================================================================
// A charger whose modes hold composite states (precharge, bulk, absorption),
// entry, exit and do actions, a timed transition and a second region (the
// cooling fan); typed variables, a current loop (PID), a voltage filter,
// a charge counter (integrator), guards and actions written as code.
// Every part of it is generated by `arclang export -f c` and proven against
// the model by `arclang sil`.
//
//   arclang check  examples/energy/battery-charger/battery_charger.arc
//   arclang export examples/energy/battery-charger/battery_charger.arc -f c -o build/charger
//   arclang sil    examples/energy/battery-charger/battery_charger.arc
//   arclang hdl    examples/energy/battery-charger/battery_charger.arc --synth
//   arclang cosim  examples/energy/battery-charger/battery_charger.arc   (FMUs and SSP in OMSimulator, docs/cosimulation.md)
// ============================================================================

model BatteryCharger {
    metadata {
        version: "1.0.0"
        description: "Charge controller of a 48 V battery, modes and fan"
        domain: "energy"
    }
}

requirements system {
    req "SYS-CHG-001" "Precharge before bulk" {
        description: "The charger shall precharge the battery for at least 200 ms before bulk charging"
        priority: "Critical"
    }
    req "SYS-CHG-002" "Unplug stops the charge" {
        description: "Unplugging shall open the contactors whatever the charging phase"
        priority: "Critical"
    }
    req "SYS-CHG-003" "Fan on while hot" {
        description: "The cooling fan shall run while the charger is above its temperature limit"
        priority: "High"
    }
    req "SYS-CHG-004" "Current regulated" {
        description: "The charger shall regulate the charge current to 2 A in precharge and 16 A in bulk, its setpoint never above 20 A"
        priority: "Critical"
    }
    req "SYS-CHG-005" "Absorption at 54.6 V" {
        description: "The charger shall go from bulk to absorption when the filtered battery voltage reaches 54.6 V"
        priority: "High"
    }
}

// The hardware/software split (docs/embedded-fpga.md): the charge
// controller is computed by the programmable logic of the SoC, in fixed
// point; the processor runs the I/O and calls it through its registers.
physical_architecture "Charger hardware" {
    node "Charger SoC" {
        id: "PN-CHG-SOC"
        processor: "VexRiscv (LiteX)"
    }
    node "Charger fabric" {
        id: "PN-CHG-FABRIC"
        kind: "fpga"
        device: "LFE5U-25F-6BG381C"
        clock: 25 MHz
        behavior_component "Charge controller" { id: "PC-CHG-CTRL" }
    }
}

state_machine "Charger" {
    owner: "PC-CHG-CTRL"
    // The data the controller computes: measured inputs, a current loop, a
    // first-order filter of the voltage, the charge delivered. The ranges
    // give the fixed-point formats of the hardware.
    variables: [
        "in voltage: Real [V] range 0 V .. 60 V",
        "in current: Real [A] range -25 A .. 25 A",
        "const v_absorption: Real [V] = 54.6 V",
        "const i_bulk: Real [A] = 16 A",
        "target: Real [A] = 0 A",
        "error: Real [A]",
        "out setpoint: Real [A]",
        "filtered: Real [V] range 0 V .. 60 V = 0 V",
        "previous: Real [V]",
        "out charge: Real [Ah] range -10 Ah .. 10 Ah",
        "out plugs: Integer = 0"
    ]
    equations: [
        "error = target - current",
        "setpoint = pid(error, 0.5, 20 Hz, 0 s, 0 A, 20 A)",
        "filtered = filtered + 0.2 * (voltage - filtered)",
        "previous = delay(voltage, 48 V)",
        "charge = integrator(current, 1)"
    ]
    region "Charge" {
        initial: "Idle"
        state Idle { exit: "lock connector" }
        state Charging {
            initial: "Precharge"
            entry: ["close contactors", "plugs := plugs + 1"]
            exit: ["open contactors", "target := 0 A"]
            do: "regulate current"
            state Precharge { entry: ["limit current", "target := 2 A"] }
            state Bulk { entry: ["ramp current", "target := i_bulk"] }
            state Absorption { entry: ["hold voltage", "target := 4 A"] }
            transition Precharge -> Bulk { timing: 200 ms }
            transition Bulk -> Absorption { trigger: "voltage reached" }
            transition Bulk -> Absorption { guard: "filtered >= v_absorption and target > 0 A" }
        }
        state Fault { entry: "raise alarm" }
        transition Idle -> Charging { trigger: "plug" guard: "battery present" action: "authorize" }
        transition Charging -> Idle { trigger: "unplug" }
        transition Charging -> Fault { trigger: "fault" priority: 1 }
        transition Fault -> Idle { trigger: "reset" guard: "fault cleared" }
    }
    region "Cooling" {
        initial: "FanOff"
        state FanOff {}
        state FanOn { do: "drive fan" }
        transition FanOff -> FanOn { trigger: "temperature" guard: "above limit" }
        transition FanOn -> FanOff { trigger: "temperature" guard: "below limit" }
    }
}

io_binding "Charger board" {
    machine: "Charger"
    target: "zephyr/litex_vexriscv"
    period: 10 ms
    watchdog: true
    inputs: [
        "plug <- gpio 2 rising",
        "unplug <- gpio 2 falling",
        "battery present <- gpio 3",
        "voltage reached <- can 0x210",
        "fault <- uart 0 0x46",
        "reset <- uart 0 0x52",
        "fault cleared <- gpio 4",
        "temperature <- can 0x211",
        "above limit <- adc 1 > 3000",
        "below limit <- adc 1 < 2500"
    ]
    outputs: [
        "Charging -> gpio 20",
        "Fault -> gpio 21",
        "FanOn -> pwm 0 600",
        "close contactors -> uart 1 0x43",
        "open contactors -> uart 1 0x4F"
    ]
}

test_case "TC-CHG-001" {
    verifies: ["SYS-CHG-001", "SYS-CHG-002"]
    method: "test"
    description: "Plug, precharge 200 ms, bulk, absorption, unplug"
    execute: {
        machine: "Charger"
        step: 10 ms
        stop_time: 600 ms
        inputs: [
            "0 s: battery present", "20 ms: plug",
            "400 ms: voltage reached",
            "500 ms: unplug"
        ]
    }
    expects: [
        "SYS-CHG-001: at(210 ms, \"Charger\".Charging.Precharge) == 1",
        "SYS-CHG-001: at(230 ms, \"Charger\".Charging.Bulk) == 1",
        "at(400 ms, \"Charger\".Charging.Absorption) == 1",
        "SYS-CHG-002: final(\"Charger\".Idle) == 1",
        "SYS-CHG-002: at(500 ms, \"Charger\".action.open_contactors) == 1",
        "at(20 ms, \"Charger\".action.close_contactors) == 1",
        "max(\"Charger\".action.regulate_current) == 1"
    ]
}

test_case "TC-CHG-002" {
    verifies: ["SYS-CHG-003"]
    method: "test"
    description: "Fan on above the limit, a fault while charging, reset: through the board's I/O"
    execute: {
        machine: "Charger"
        binding: "Charger board"
        stop_time: 400 ms
        inputs: [
            "0 s: battery present", "10 ms: plug",
            "50 ms: above limit", "60 ms: temperature",
            "100 ms: fault",
            "150 ms: above limit = false", "150 ms: below limit", "160 ms: temperature",
            "200 ms: fault cleared", "210 ms: reset"
        ]
    }
    expects: [
        "at(60 ms, \"Charger\".FanOn) == 1",
        "at(100 ms, \"Charger\".Fault) == 1",
        "at(160 ms, \"Charger\".FanOff) == 1",
        "final(\"Charger\".Idle) == 1"
    ]
}

test_case "TC-CHG-003" {
    verifies: ["SYS-CHG-004", "SYS-CHG-005"]
    method: "test"
    description: "The current loop and the voltage filter: precharge at 2 A, bulk at 16 A, absorption when the filtered voltage reaches 54.6 V"
    execute: {
        machine: "Charger"
        step: 10 ms
        stop_time: 600 ms
        inputs: [
            "0 s: battery present", "0 s: voltage = 50 V", "0 s: current = 0 A",
            "20 ms: plug",
            "100 ms: current = 1.5 A",
            "250 ms: current = 12 A",
            "300 ms: voltage = 56 V",
            "450 ms: current = 15.5 A"
        ]
    }
    expects: [
        "SYS-CHG-004: at(100 ms, \"Charger\".target) == 2 A",
        "SYS-CHG-004: at(300 ms, \"Charger\".target) == 16 A",
        "SYS-CHG-004: max(\"Charger\".setpoint) <= 20 A",
        "SYS-CHG-004: min(\"Charger\".setpoint) >= 0 A",
        "SYS-CHG-005: at(290 ms, \"Charger\".Charging.Bulk) == 1",
        "SYS-CHG-005: at(400 ms, \"Charger\".Charging.Absorption) == 1",
        "final(\"Charger\".plugs) == 1",
        "final(\"Charger\".charge) > 0.0001 Ah",
        "final(\"Charger\".previous) == 56 V"
    ]
}

// The controller closed on the physics (docs/embedded-c.md, "The plant in
// the loop"): the current it asks for drives the pack, the pack's voltage
// and current come back as its inputs. No input list can say whether the
// filtered voltage reaches 54.6 V: only the loop does. `arclang sil` runs
// the C in it, `arclang soc` the SoC; `arclang hdl` and `arclang pil`
// replay the loop's vectors.
test_case "TC-CHG-HIL" {
    verifies: ["SYS-CHG-004", "SYS-CHG-005"]
    method: "test"
    description: "In the loop with the pack: precharge at 2 A, bulk at 16 A lifts the terminals past 54.6 V, absorption at 4 A"
    execute: {
        machine: "Charger"
        step: 10 ms
        stop_time: 1.5 s
        inputs: ["0 s: battery present", "20 ms: plug"]
        plant: {
            model: "ChargerPhysics.Battery"
            sources: ["physics/ChargerPhysics.mo"]
            inputs: ["i_set <- setpoint"]
            outputs: ["voltage <- v_batt", "current <- i_batt"]
        }
    }
    expects: [
        "SYS-CHG-004: at(200 ms, \"Charger\".target) == 2 A",
        "SYS-CHG-004: at(200 ms, \"Charger\".current) > 1.5 A",
        "SYS-CHG-004: at(200 ms, \"Charger\".current) < 2.5 A",
        "SYS-CHG-004: max(\"Charger\".setpoint) <= 20 A",
        "SYS-CHG-004: at(300 ms, \"Charger\".Charging.Bulk) == 1",
        "SYS-CHG-005: at(1 s, \"Charger\".Charging.Absorption) == 1",
        "SYS-CHG-005: at(1.4 s, \"Charger\".current) < 5 A",
        "final(\"Charger\".charge) > 0.001 Ah"
    ]
}
