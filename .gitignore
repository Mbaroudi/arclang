# Rust
/target/
**/*.rs.bk
*.pdb

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
*.o
*.so
*.dylib
*.dll
*.exe

# Generated files
*.json
# Data the export compiles in (include_str!).
!src/compiler/capella_export/*.json
# The figures the Capella bench must keep.
!tools/capella_bench/baseline.json
# The built-in diagram themes (include_str!) and the fixtures of their validator.
!src/compiler/diagram/viewer/themes/*.json
!tests/fixtures/themes/*.json
*.xml
!examples/**/*.xml

# Generated diagrams (the explorer pages of the examples are regenerated by `arclang explorer`)
*.html
!acc_ultimate.html

# Logs
*.log

# Temporary files
tmp/
temp/
.tmp/

# OS
Thumbs.db
.DS_Store

# Package managers
node_modules/
package-lock.json
yarn.lock

# Environment
.env
.env.local

# Coverage
coverage/
*.profraw
*.profdata

# Backup files
*.bak
*.backup
*~

# Documentation builds
docs/build/

# LinkedIn launch materials (private)
LINKEDIN_POST.md
LINKEDIN_SHORT_POST.md
LAUNCH_CHECKLIST.md
COPY_PASTE_POST.txt
wasm/target/
wasm/pkg/

# Golden test fixtures are source, not build output
!tests/fixtures/diagrams/*.json
# Layout files are sources: they are kept next to the model they arrange.
!*.layout.json
# Generated by the pilot but compiled into the binary (include_str!): it is a source.
!spec/sysml_library_index.json

# Python bytecode
__pycache__/

# The VS Code extension manifests are sources, not outputs.
!editors/vscode/package.json
!editors/vscode/language-configuration.json
!editors/vscode/syntaxes/*.json
.arclang/
