{
  "name": "arclang",
  "displayName": "ArcLang",
  "description": "Arcadia MBSE as code: diagnostics with rules, outline, completion from the metamodel, hover, go to definition, rename, formatting, the viewpoint diagrams beside the source, the production gate, Arcadia transitions, the @arclang chat participant and compiler tools for agent mode, the ArcLang MCP server. Everything comes from the ArcLang compiler.",
  "version": "4.3.0",
  "publisher": "arclang",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://arclang.fr",
  "bugs": {
    "url": "https://github.com/Mbaroudi/arclang/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mbaroudi/arclang",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "The extension runs the arclang compiler on files of the local file system."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace the compiler is not run on its files: no diagnostics, commands, diagrams or tools until the workspace is trusted. The executable and the MCP server command can only be set in user settings.",
      "restrictedConfigurations": [
        "arclang.binary",
        "arclang.mcp.command",
        "arclang.mcp.args"
      ]
    }
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Visualization",
    "AI",
    "Chat"
  ],
  "keywords": [
    "arcadia",
    "capella",
    "mbse",
    "systems engineering",
    "sysml",
    "sysml v2",
    "model-based",
    "chat-participant",
    "mcp"
  ],
  "activationEvents": [
    "onLanguage:arclang",
    "onView:arclangModel",
    "onLanguage:sysml",
    "onView:arclangRelations"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "arclang",
        "aliases": [
          "ArcLang",
          "arclang"
        ],
        "extensions": [
          ".arc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/file-icon.svg",
          "dark": "./media/file-icon.svg"
        }
      },
      {
        "id": "sysml",
        "aliases": [
          "SysML v2",
          "sysml"
        ],
        "extensions": [
          ".sysml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "arclang",
        "scopeName": "source.arclang",
        "path": "./syntaxes/arclang.tmLanguage.json"
      },
      {
        "language": "sysml",
        "scopeName": "source.sysml",
        "path": "./syntaxes/sysml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "arclang.openDiagrams",
        "title": "Open the read-only diagram page (legacy)",
        "category": "ArcLang",
        "icon": "$(graph)"
      },
      {
        "command": "arclang.check",
        "title": "Check the model (rules and findings)",
        "category": "ArcLang"
      },
      {
        "command": "arclang.runGate",
        "title": "Run the production gate",
        "category": "ArcLang"
      },
      {
        "command": "arclang.format",
        "title": "Format the model",
        "category": "ArcLang"
      },
      {
        "command": "arclang.transitionPlan",
        "title": "Transition plan (what each Arcadia step would create)",
        "category": "ArcLang"
      },
      {
        "command": "arclang.transitionApply",
        "title": "Apply an Arcadia transition step",
        "category": "ArcLang"
      },
      {
        "command": "arclang.impact",
        "title": "Change impact of an element",
        "category": "ArcLang"
      },
      {
        "command": "arclang.diffWithHead",
        "title": "Semantic diff against the committed version",
        "category": "ArcLang"
      },
      {
        "command": "arclang.export",
        "title": "Export (SysML v2, Capella, ReqIF, C headers, ...)",
        "category": "ArcLang"
      },
      {
        "command": "arclang.import",
        "title": "Import (SysML v2, Capella, ReqIF, ...)",
        "category": "ArcLang"
      },
      {
        "command": "arclang.showMetamodel",
        "title": "Show the language metamodel",
        "category": "ArcLang"
      },
      {
        "command": "arclang.showRules",
        "title": "Show the catalogue of rules",
        "category": "ArcLang"
      },
      {
        "command": "arclang.restartServer",
        "title": "Restart the language server",
        "category": "ArcLang"
      },
      {
        "command": "arclang.installBinary",
        "title": "Install or locate the arclang compiler",
        "category": "ArcLang"
      },
      {
        "command": "arclang.openWorkbench",
        "title": "Open the workbench beside the source",
        "category": "ArcLang",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "arclang.model.reveal",
        "title": "Go to source",
        "category": "ArcLang"
      },
      {
        "command": "arclang.model.rename",
        "title": "Rename…",
        "category": "ArcLang"
      },
      {
        "command": "arclang.model.delete",
        "title": "Delete",
        "category": "ArcLang"
      },
      {
        "command": "arclang.model.ask",
        "title": "Ask @arclang about this element",
        "category": "ArcLang"
      },
      {
        "command": "arclang.model.refresh",
        "title": "Refresh the model tree",
        "category": "ArcLang",
        "icon": "$(refresh)"
      },
      {
        "command": "arclang.openDiagram",
        "title": "Open the diagram",
        "category": "ArcLang"
      },
      {
        "command": "arclang.pickDiagram",
        "title": "Open a diagram…",
        "category": "ArcLang",
        "icon": "$(graph)"
      },
      {
        "command": "arclang.pickElement",
        "title": "Go to an element…",
        "category": "ArcLang"
      },
      {
        "command": "arclang.model.select",
        "title": "Select",
        "category": "ArcLang"
      },
      {
        "command": "arclang.model.openDiagram",
        "title": "Open in a diagram",
        "category": "ArcLang"
      },
      {
        "command": "arclang.model.copyId",
        "title": "Copy the id",
        "category": "ArcLang"
      },
      {
        "command": "arclang.canvas.rename",
        "title": "Rename…",
        "category": "ArcLang"
      },
      {
        "command": "arclang.canvas.delete",
        "title": "Delete from model",
        "category": "ArcLang"
      },
      {
        "command": "arclang.canvas.reveal",
        "title": "Show in source",
        "category": "ArcLang"
      },
      {
        "command": "arclang.canvas.tree",
        "title": "Show in model tree",
        "category": "ArcLang"
      },
      {
        "command": "arclang.canvas.ask",
        "title": "Ask @arclang about this element",
        "category": "ArcLang"
      },
      {
        "command": "arclang.canvas.copyId",
        "title": "Copy the id",
        "category": "ArcLang"
      },
      {
        "command": "arclang.relations.step",
        "title": "Go to the related element",
        "category": "ArcLang"
      },
      {
        "command": "arclang.layer.next",
        "title": "Next layer (diagram)",
        "category": "ArcLang"
      },
      {
        "command": "arclang.layer.previous",
        "title": "Previous layer (diagram)",
        "category": "ArcLang"
      },
      {
        "command": "arclang.openLayer",
        "title": "Open the diagram of this layer",
        "category": "ArcLang"
      },
      {
        "command": "arclang.canvas.hide",
        "title": "Hide from this diagram",
        "category": "ArcLang"
      },
      {
        "command": "arclang.canvas.related",
        "title": "Show related elements",
        "category": "ArcLang"
      },
      {
        "command": "arclang.canvas.newDiagram",
        "title": "New diagram from this element",
        "category": "ArcLang"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "arclang.openWorkbench",
          "when": "resourceLangId == arclang",
          "group": "navigation@1"
        },
        {
          "command": "arclang.openWorkbench",
          "when": "resourceLangId == sysml",
          "group": "navigation@1"
        },
        {
          "command": "arclang.pickDiagram",
          "when": "resourceLangId == arclang || resourceLangId == sysml",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "arclang.impact",
          "when": "resourceLangId == arclang",
          "group": "arclang@1"
        },
        {
          "command": "arclang.openWorkbench",
          "when": "resourceLangId == arclang",
          "group": "arclang@0"
        },
        {
          "command": "arclang.openWorkbench",
          "when": "resourceLangId == sysml",
          "group": "arclang@0"
        }
      ],
      "explorer/context": [
        {
          "command": "arclang.runGate",
          "when": "resourceExtname == .arc",
          "group": "arclang@2"
        },
        {
          "command": "arclang.export",
          "when": "resourceExtname == .arc",
          "group": "arclang@3"
        },
        {
          "command": "arclang.openWorkbench",
          "when": "resourceExtname == .arc",
          "group": "arclang@0"
        },
        {
          "command": "arclang.openWorkbench",
          "when": "resourceExtname == .sysml",
          "group": "arclang@0"
        },
        {
          "command": "arclang.import",
          "when": "resourceExtname == .sysml",
          "group": "arclang@1"
        }
      ],
      "commandPalette": [
        {
          "command": "arclang.openDiagrams",
          "when": "resourceLangId == arclang"
        },
        {
          "command": "arclang.check",
          "when": "resourceLangId == arclang"
        },
        {
          "command": "arclang.runGate",
          "when": "resourceLangId == arclang"
        },
        {
          "command": "arclang.format",
          "when": "resourceLangId == arclang"
        },
        {
          "command": "arclang.transitionPlan",
          "when": "resourceLangId == arclang"
        },
        {
          "command": "arclang.transitionApply",
          "when": "resourceLangId == arclang"
        },
        {
          "command": "arclang.impact",
          "when": "resourceLangId == arclang"
        },
        {
          "command": "arclang.diffWithHead",
          "when": "resourceLangId == arclang"
        },
        {
          "command": "arclang.export",
          "when": "resourceLangId == arclang"
        },
        {
          "command": "arclang.model.reveal",
          "when": "false"
        },
        {
          "command": "arclang.model.rename",
          "when": "false"
        },
        {
          "command": "arclang.model.delete",
          "when": "false"
        },
        {
          "command": "arclang.model.ask",
          "when": "false"
        },
        {
          "command": "arclang.openDiagram",
          "when": "false"
        },
        {
          "command": "arclang.model.select",
          "when": "false"
        },
        {
          "command": "arclang.model.openDiagram",
          "when": "false"
        },
        {
          "command": "arclang.model.copyId",
          "when": "false"
        },
        {
          "command": "arclang.canvas.rename",
          "when": "false"
        },
        {
          "command": "arclang.canvas.delete",
          "when": "false"
        },
        {
          "command": "arclang.canvas.reveal",
          "when": "false"
        },
        {
          "command": "arclang.canvas.tree",
          "when": "false"
        },
        {
          "command": "arclang.canvas.ask",
          "when": "false"
        },
        {
          "command": "arclang.canvas.copyId",
          "when": "false"
        },
        {
          "command": "arclang.relations.step",
          "when": "false"
        },
        {
          "command": "arclang.openLayer",
          "when": "false"
        },
        {
          "command": "arclang.canvas.hide",
          "when": "false"
        },
        {
          "command": "arclang.canvas.related",
          "when": "false"
        },
        {
          "command": "arclang.canvas.newDiagram",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "arclang.model.refresh",
          "when": "view == arclangModel",
          "group": "navigation@1"
        },
        {
          "command": "arclang.openWorkbench",
          "when": "view == arclangModel",
          "group": "navigation@2"
        },
        {
          "command": "arclang.pickDiagram",
          "when": "view == arclangModel",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "arclang.model.reveal",
          "when": "view == arclangModel && viewItem == arclang.element",
          "group": "navigation@1"
        },
        {
          "command": "arclang.model.ask",
          "when": "view == arclangModel && viewItem == arclang.element",
          "group": "navigation@2"
        },
        {
          "command": "arclang.model.rename",
          "when": "view == arclangModel && viewItem == arclang.element",
          "group": "edit@1"
        },
        {
          "command": "arclang.model.delete",
          "when": "view == arclangModel && viewItem == arclang.element",
          "group": "edit@2"
        },
        {
          "command": "arclang.model.openDiagram",
          "when": "view == arclangModel && viewItem == arclang.element",
          "group": "navigation@0"
        },
        {
          "command": "arclang.model.copyId",
          "when": "view == arclangModel && viewItem == arclang.element",
          "group": "edit@3"
        }
      ],
      "webview/context": [
        {
          "command": "arclang.canvas.reveal",
          "when": "webviewId == 'arclang.workbench' && webviewSection == 'element'",
          "group": "navigation@1"
        },
        {
          "command": "arclang.canvas.tree",
          "when": "webviewId == 'arclang.workbench' && webviewSection == 'element'",
          "group": "navigation@2"
        },
        {
          "command": "arclang.canvas.ask",
          "when": "webviewId == 'arclang.workbench' && webviewSection == 'element'",
          "group": "navigation@3"
        },
        {
          "command": "arclang.canvas.rename",
          "when": "webviewId == 'arclang.workbench' && webviewSection == 'element'",
          "group": "edit@1"
        },
        {
          "command": "arclang.canvas.delete",
          "when": "webviewId == 'arclang.workbench' && webviewSection == 'element'",
          "group": "edit@2"
        },
        {
          "command": "arclang.canvas.copyId",
          "when": "webviewId == 'arclang.workbench' && webviewSection == 'element'",
          "group": "edit@3"
        },
        {
          "command": "arclang.canvas.hide",
          "when": "webviewId == 'arclang.workbench' && webviewSection == 'element'",
          "group": "diagram@1"
        },
        {
          "command": "arclang.canvas.related",
          "when": "webviewId == 'arclang.workbench' && webviewSection == 'element'",
          "group": "diagram@2"
        },
        {
          "command": "arclang.canvas.newDiagram",
          "when": "webviewId == 'arclang.workbench' && webviewSection == 'element'",
          "group": "diagram@3"
        }
      ]
    },
    "configuration": {
      "title": "ArcLang",
      "properties": {
        "arclang.binary": {
          "type": "string",
          "default": "arclang",
          "markdownDescription": "The `arclang` executable: a name on the PATH or an absolute path. The extension runs `arclang lsp --stdio`, `arclang diagram`, `arclang check`, `arclang gate`, `arclang transition`, `arclang export`, `arclang import`, `arclang set`, `arclang rename`. User setting only: a workspace cannot choose the executable the extension runs.",
          "scope": "machine"
        },
        "arclang.diagrams.refreshOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Redraw the open diagrams every time their model is saved."
        },
        "arclang.gate.standard": {
          "type": "string",
          "default": "iso26262",
          "enum": [
            "iso26262",
            "do178c",
            "iec61508"
          ],
          "description": "The standard the production gate judges against."
        },
        "arclang.ai.repairAttempts": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "markdownDescription": "When a model written by `@arclang` does not compile, how many times the compiler's errors are sent back to the model before the answer is shown as is."
        },
        "arclang.mcp.command": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command that starts the ArcLang MCP server for agent mode (for example `arclang-mcp`, or `uv run --directory /path/to/arclang/mcp-server arclang-mcp`). Empty: the server is offered only when `arclang-mcp` is on the PATH.",
          "scope": "machine"
        },
        "arclang.mcp.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments of the MCP server command.",
          "scope": "machine"
        }
      }
    },
    "chatParticipants": [
      {
        "id": "arclang.assistant",
        "name": "arclang",
        "fullName": "ArcLang",
        "description": "Model in Arcadia with the compiler at hand: write, fix, explain and review ArcLang models.",
        "isSticky": true,
        "commands": [
          {
            "name": "model",
            "description": "Write or extend an ArcLang model from a description. The result is compiled before it is shown."
          },
          {
            "name": "fix",
            "description": "Fix the compiler errors and findings of the open model, minimally."
          },
          {
            "name": "explain",
            "description": "Explain the open model, an element or a finding, from what the compiler knows."
          },
          {
            "name": "review",
            "description": "Review the open model: coverage, traces, safety, timing, against the production gate."
          },
          {
            "name": "transition",
            "description": "Plan and apply the next Arcadia transition (OA to SA, SA to LA, LA to PA)."
          },
          {
            "name": "agent",
            "description": "Change the open model step by step through the compiler: read the elements, apply precise edits you confirm, check the result."
          }
        ],
        "disambiguation": [
          {
            "category": "arclang_modeling",
            "description": "The user wants to write, fix, review or understand an Arcadia / ArcLang / Capella model (.arc file): requirements, functions, components, traces, safety, timing.",
            "examples": [
              "Write the logical architecture of an emergency braking system",
              "Why does the gate fail on this model?",
              "Add a hazard for late braking"
            ]
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "arclang_check",
        "displayName": "ArcLang: check a model",
        "toolReferenceName": "arclangCheck",
        "canBeReferencedInPrompt": true,
        "icon": "$(checklist)",
        "userDescription": "Compile a .arc model and report the compiler's errors and rule findings.",
        "modelDescription": "Compiles an ArcLang (.arc) model with the ArcLang compiler and returns its errors and its findings as JSON: each finding has a rule (see arclang_rules), a severity, the element concerned and, when the compiler knows one, a fix. Use it after every edit of a model and before claiming a model is correct. Input: either the absolute path of a .arc file, or the full source text.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path of the .arc file to check."
            },
            "source": {
              "type": "string",
              "description": "Full ArcLang source to check instead of a file."
            }
          }
        }
      },
      {
        "name": "arclang_gate",
        "displayName": "ArcLang: production gate",
        "toolReferenceName": "arclangGate",
        "canBeReferencedInPrompt": true,
        "icon": "$(shield)",
        "userDescription": "Run the production-readiness gate on a .arc model.",
        "modelDescription": "Runs the ArcLang production gate on a .arc model: a PASS/FAIL verdict against what an industrial design review requires (requirements coverage, HARA/ASIL consistency, timing budgets, ICD completeness), for a standard (iso26262, do178c, iec61508). Returns the compiler's report verbatim.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path of the .arc file."
            },
            "standard": {
              "type": "string",
              "enum": [
                "iso26262",
                "do178c",
                "iec61508"
              ],
              "description": "The standard to judge against (default iso26262)."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "arclang_metamodel",
        "displayName": "ArcLang: language metamodel",
        "toolReferenceName": "arclangMetamodel",
        "canBeReferencedInPrompt": true,
        "icon": "$(book)",
        "userDescription": "The ArcLang language reference, printed by the compiler.",
        "modelDescription": "Returns the ArcLang language metamodel as the compiler prints it: element kinds per Arcadia level, their typed attributes, enumerations, units of quantities and the trace rules. Read it before writing ArcLang; it is the only syntax reference to trust. Optionally filtered to one element kind.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "description": "An element kind to focus on (for example 'component', 'requirement', 'functional_chain'). Omit for the whole metamodel."
            }
          }
        }
      },
      {
        "name": "arclang_rules",
        "displayName": "ArcLang: catalogue of rules",
        "toolReferenceName": "arclangRules",
        "canBeReferencedInPrompt": true,
        "icon": "$(law)",
        "userDescription": "The catalogue of validation rules the compiler checks.",
        "modelDescription": "Returns the catalogue of ArcLang validation rules (what arclang_check reports) as JSON: rule id, severity, what it checks and how to satisfy it.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "arclang_impact",
        "displayName": "ArcLang: change impact",
        "toolReferenceName": "arclangImpact",
        "canBeReferencedInPrompt": true,
        "icon": "$(references)",
        "userDescription": "Everything transitively affected when an element changes.",
        "modelDescription": "Change-impact analysis of one element of a .arc model (requirement, component, function, by id or unambiguous name): everything transitively affected through traces, allocations, exchanges and deployments, as the compiler reports it.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path of the .arc file."
            },
            "element": {
              "type": "string",
              "description": "Element id or unambiguous name, for example REQ-AEB-004."
            }
          },
          "required": [
            "path",
            "element"
          ]
        }
      },
      {
        "name": "arclang_transition_plan",
        "displayName": "ArcLang: Arcadia transition plan",
        "toolReferenceName": "arclangTransitionPlan",
        "canBeReferencedInPrompt": true,
        "icon": "$(arrow-right)",
        "userDescription": "What each Arcadia transition step would create.",
        "modelDescription": "For a .arc model, says what each Arcadia transition step (oa-to-sa, sa-to-la, la-to-pa) would declare on the next level: the elements already realized and those still to create, as the compiler's JSON plan. Nothing is written.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path of the .arc file."
            },
            "step": {
              "type": "string",
              "enum": [
                "oa-to-sa",
                "sa-to-la",
                "la-to-pa"
              ],
              "description": "One step; omit for every step."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "arclang_set_attribute",
        "displayName": "ArcLang: set an attribute",
        "toolReferenceName": "arclangSet",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "userDescription": "Set one attribute of one element, through the compiler's lossless editor.",
        "modelDescription": "Sets one attribute of one element of an open .arc model through the compiler's source editor: comments and layout are kept, and the edit is refused unless the edited model compiles. The change is applied in the editor as an undoable edit. Value is ArcLang source: '\"text\"', '25 ms', '[A, B]', 'true'.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path of the .arc file."
            },
            "element": {
              "type": "string",
              "description": "Identifier of the element, or its name when it has no id."
            },
            "key": {
              "type": "string",
              "description": "Attribute name."
            },
            "value": {
              "type": "string",
              "description": "Value as ArcLang source."
            }
          },
          "required": [
            "path",
            "element",
            "key",
            "value"
          ]
        }
      },
      {
        "name": "arclang_rename",
        "displayName": "ArcLang: rename an element",
        "toolReferenceName": "arclangRename",
        "canBeReferencedInPrompt": true,
        "icon": "$(symbol-string)",
        "userDescription": "Rename one element without changing its identity.",
        "modelDescription": "Renames one element of an open .arc model through the compiler's source editor; refused when the element is known by its name elsewhere, because its identity must not change. Applied as an undoable edit.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path of the .arc file."
            },
            "element": {
              "type": "string",
              "description": "Identifier of the element."
            },
            "name": {
              "type": "string",
              "description": "The new name."
            }
          },
          "required": [
            "path",
            "element",
            "name"
          ]
        }
      },
      {
        "name": "arclang_model",
        "displayName": "ArcLang: read the model",
        "toolReferenceName": "arclangModel",
        "canBeReferencedInPrompt": true,
        "icon": "$(list-tree)",
        "userDescription": "The elements of a model as the compiler sees them, with their ids, kinds, owners and attributes.",
        "modelDescription": "Reads an open .arc model through the compiler (arclang workbench): counts by kind, the elements (id, kind, name, owner, attributes) filtered by kind, layer or one element (then with its relationships and traces), the findings and the gate. Use it before editing to know the exact ids; the ids it lists are accepted by arclang_edit even when the text writes none.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path of the .arc file."
            },
            "kind": {
              "type": "string",
              "description": "Only the elements of this kind (LogicalComponent, SystemFunction, Requirement...)."
            },
            "layer": {
              "type": "string",
              "description": "Only the elements of this layer: Operational, System, Logical, Physical, Epbs, Data, Transverse."
            },
            "element": {
              "type": "string",
              "description": "Only this element (id or name), with what it is connected to."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "arclang_edit",
        "displayName": "ArcLang: edit the model",
        "toolReferenceName": "arclangEdit",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "userDescription": "Add, remove, move, rename, trace or set elements of a model; refused unless the model still compiles.",
        "modelDescription": "Applies a list of edits to an open .arc model through the compiler's source editor (arclang edit), in order, as one undoable change in the editor: add an element inside another, in a layer or at the top level (ports with keyword 'port in'/'port out'), add a raw declaration (exchanges, messages, transitions), remove, move, rename (identity kept), set/unset an attribute, add/remove a trace, wrap messages in a fragment. Comments and layout are kept. The whole list is refused, and nothing changes, if any edit would leave a model that does not compile; the answer says which request and why. Prefer this over rewriting the file.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path of the .arc file."
            },
            "requests": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "One edit of the model text. op is one of set, unset, rename, add, add_raw, remove, move, add_trace, remove_trace, wrap_fragment. Elements are designated by the id the model tool lists (or the name when it writes none).",
                "properties": {
                  "op": {
                    "type": "string",
                    "enum": [
                      "set",
                      "unset",
                      "rename",
                      "add",
                      "add_raw",
                      "remove",
                      "move",
                      "add_trace",
                      "remove_trace",
                      "wrap_fragment"
                    ]
                  },
                  "element": {
                    "type": "string",
                    "description": "set/unset/rename/remove/move: the element."
                  },
                  "key": {
                    "type": "string",
                    "description": "set/unset: the attribute."
                  },
                  "value": {
                    "type": "string",
                    "description": "set: the value as ArcLang source: '\"text\"', '25 ms', '[A, B]', 'ASIL-D'."
                  },
                  "name": {
                    "type": "string",
                    "description": "rename: the new name; add: the name of the new element."
                  },
                  "keyword": {
                    "type": "string",
                    "description": "add: the declaration keyword: actor, entity, activity, function, component, node, behavior_component, 'port in', 'port out', interface, class, mission, capability, functional_chain, requirement..."
                  },
                  "attributes": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "description": "add: [key, value] pairs written with the new element, values as ArcLang source."
                  },
                  "declaration": {
                    "type": "string",
                    "description": "add_raw: one declaration as ArcLang source, e.g. 'component_exchange \"Flow\" { from_port: \"LC-A.p\" to_port: \"LC-B.q\" }' or 'message \"A\" -> \"B\" \"text\"'."
                  },
                  "container": {
                    "type": "string",
                    "description": "add/add_raw/move: the element the declaration goes into."
                  },
                  "layer": {
                    "type": "string",
                    "description": "add/add_raw/move: else the layer block: operational_analysis, system_analysis, logical_architecture, physical_architecture, epbs."
                  },
                  "layer_name": {
                    "type": "string",
                    "description": "add/add_raw/move: the layer's name when several layers of that kind exist."
                  },
                  "top_level": {
                    "type": "boolean",
                    "description": "add/add_raw: else at the end of the file (classes, data types, traces)."
                  },
                  "from": {
                    "type": "string",
                    "description": "add_trace/remove_trace: the source element."
                  },
                  "kind": {
                    "type": "string",
                    "description": "add_trace/remove_trace: satisfies, implements, realizes, allocates, verifies...; wrap_fragment: loop, opt, alt, par, seq, critical."
                  },
                  "to": {
                    "type": "string",
                    "description": "add_trace/remove_trace: the target element."
                  },
                  "scenario": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "first": {
                    "type": "string"
                  },
                  "last": {
                    "type": "string"
                  },
                  "operands": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "required": [
                  "op"
                ]
              },
              "minItems": 1,
              "description": "The edits, applied in order on one text."
            }
          },
          "required": [
            "path",
            "requests"
          ]
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "arclang.mcp",
        "label": "ArcLang MCP server"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arclang",
          "title": "ArcLang",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "arclang": [
        {
          "id": "arclangModel",
          "name": "Model",
          "contextualTitle": "ArcLang model",
          "icon": "media/icon.svg"
        },
        {
          "id": "arclangRelations",
          "name": "Relations",
          "contextualTitle": "ArcLang relations",
          "icon": "media/icon.svg"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "arclang.workbench",
        "displayName": "ArcLang Workbench",
        "selector": [
          {
            "filenamePattern": "*.arc"
          },
          {
            "filenamePattern": "*.sysml"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "command": "arclang.pickDiagram",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "resourceLangId == arclang || resourceLangId == sysml || activeCustomEditorId == arclang.workbench"
      },
      {
        "command": "arclang.pickElement",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "resourceLangId == arclang || resourceLangId == sysml || activeCustomEditorId == arclang.workbench"
      },
      {
        "command": "arclang.model.rename",
        "key": "f2",
        "when": "focusedView == arclangModel && viewItem == arclang.element"
      },
      {
        "command": "arclang.model.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == arclangModel && viewItem == arclang.element"
      },
      {
        "command": "arclang.layer.next",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]",
        "when": "activeCustomEditorId == arclang.workbench"
      },
      {
        "command": "arclang.layer.previous",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+[",
        "when": "activeCustomEditorId == arclang.workbench"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p webview --noEmit",
    "lint": "tsc --noEmit && tsc -p webview --noEmit",
    "test:unit": "node --test --import tsx test/unit/*.test.ts",
    "test": "npm run build && npm run test:unit && npm run test:integration",
    "vscode:prepublish": "npm run build -- --production",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "test:integration": "tsc -p ./ && vscode-test"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.104.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
